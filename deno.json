{
  "name": "@mewhhaha/terp",
  "version": "0.4.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json",
      "mod.ts",
      "docs/**/*.md",
      "examples/**/*.json",
      "examples/**/*.md",
      "examples/**/*.ts",
      "src/**/*.ts"
    ],
    "exclude": [
      "src/assert.ts",
      "src/*.test.ts"
    ]
  },
  "tasks": {
    "ci": "deno task fmt:check && deno task lint && deno task doc:lint && deno task check && deno task test:ci && deno task examples && deno task types:budget && deno task publish:dry-run",
    "check": "deno check mod.ts src/*.test.ts examples/*.ts bench/*.ts scripts/*.ts",
    "doc:lint": "deno doc --lint mod.ts",
    "examples": "deno run --allow-read=examples,scripts --allow-run=deno scripts/examples.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "test": "deno test",
    "test:ci": "deno test --no-check",
    "examples:update": "deno run --allow-read=examples,scripts --allow-write=scripts/examples.golden.json --allow-run=deno scripts/examples.ts --update",
    "bench": "deno run --no-check --allow-read --allow-write --allow-run=git scripts/bench.ts",
    "types:budget": "deno run --no-check --allow-read --allow-write --allow-run=deno,git scripts/type_bench.ts - bench/type-budget.json 1",
    "types:bench": "deno run --no-check --allow-read --allow-write --allow-run=deno,git scripts/type_bench.ts",
    "bench:lookup": "deno run --allow-read --allow-write scripts/lookup_bench.ts"
  }
}
